# ---- Receiver HTTP & Gateway Connection ----
RECEIVER_HOST=127.0.0.1
RECEIVER_PORT=5000
RECEIVER_DATA_DIR=~/whatsapp-hermes-receiver
# RECEIVER_MEDIA_DIR=~/whatsapp-hermes-receiver/media
WHATSAPP_GATEWAY_URL=http://127.0.0.1:3100
# Must match GATEWAY_API_KEY and HERMES_SECRET_TOKEN in ~/whatsapp-agent-hermes/.env
GATEWAY_API_KEY=change-me-to-a-long-random-api-key
HERMES_SECRET_TOKEN=change-me-to-a-long-random-string

# ---- Master / Principal Identity (Required) ----
# Master WhatsApp phone number with country code, digits only (e.g. 60123456789).
MASTER_PHONE=
# Optional 15-digit WhatsApp LID (learned automatically after first Master 1:1 DM).
MASTER_LID=
# Master's real name for first-person ghostwriting ("I", "me", "my").
MASTER_NAME=
DEFAULT_COUNTRY_CODE=60
TIMEZONE=Asia/Kuala_Lumpur

# ---- Local Pure-Node ONNX Whisper (Zero Python, Zero API Keys) ----
# Shorthand (tiny, base, small, medium, large-v3-turbo) or full HuggingFace ONNX ID.
WHISPER_MODEL=base
# Quantization dtype: q8 (recommended on CPU), fp32, fp16, or q4
WHISPER_DTYPE=q8
# Persistent ONNX cache directory (survives npm ci rebuilds)
WHISPER_CACHE_DIR=~/whatsapp-hermes-receiver/models

# ---- Hermes Agent Subprocess & Safety Bounds ----
HERMES_BIN=hermes
HERMES_RULES_PATH=~/.hermes/skills/whatsapp-agent-rules/SKILL.md
AGENT_TOOLSETS=web,vision
AGENT_TOOLSETS_OWNER=terminal,file,web,vision
AGENT_TIMEOUT_SECONDS=300
COALESCE_WINDOW_SECONDS=2.5
MAX_CONCURRENT_RUNS=4
DRAIN_SECONDS=120
STARTUP_REPLAY=true
REPLAY_MAX_AGE_MIN=60
HISTORY_LIMIT=30
DAILY_REPLY_LIMIT_PER_PERSON=25
HOURLY_GLOBAL_REPLY_LIMIT=60
SPLIT_MESSAGE_DELAY_SECONDS=2.0
MAX_MESSAGES_PER_TURN=5
MAX_MEDIA_BYTES=26214400
DRY_RUN=false
