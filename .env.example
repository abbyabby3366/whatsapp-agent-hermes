# ---- Required Gateway Settings ----
PORT=3100
HOST=127.0.0.1
GATEWAY_API_KEY=change-me-to-a-long-random-api-key
TIMEZONE=Asia/Kuala_Lumpur

# ---- AI Agent Webhook ----
# Incoming WhatsApp messages are POSTed here with the "x-agent-token" header.
AGENT_WEBHOOK_URL=http://127.0.0.1:5000/api/webhook
AGENT_SECRET_TOKEN=change-me-to-a-long-random-string

# ---- Owner / Receiver Identity (optional if using your own external webhook) ----
MASTER_PHONE=
MASTER_NAME=

# Optional overrides (all have defaults in src/config.ts):
# ALLOWED_NUMBERS=
# FORWARD_GROUPS=true
# DEFAULT_COUNTRY_CODE=60
# AGENT_WEBHOOK_TIMEOUT_MS=15000
# AGENT_WEBHOOK_RETRIES=2
