# ---- Gateway server ----
PORT=3100
# 127.0.0.1 = only reachable from this machine (recommended when Hermes runs on the same server).
# Use 0.0.0.0 to reach the dashboard from another computer; then also set GATEWAY_API_KEY.
HOST=127.0.0.1
# Strongly recommended even on 127.0.0.1 so untrusted agent web tools cannot query /api/status or /api/send.
# When set, every /api/* call (except /api/health) and the dashboard must send "x-api-key: <key>" or "Authorization: Bearer <key>".
GATEWAY_API_KEY=change-me-to-a-long-random-api-key

SESSIONS_DIR=./sessions
DATA_DIR=./data
# Directory allowed when sending local filesystem paths via /api/send-image, /api/send-document, or /api/send-sticker.
ALLOWED_MEDIA_DIR=./data/media
# Maximum size in bytes for outbound remote/local/data-URI media and inbound media downloads (default 25 MiB).
MAX_MEDIA_BYTES=26214400
# Timezone for timestamps shown in the dashboard and sent to Hermes
TIMEZONE=Asia/Kuala_Lumpur

# ---- Hermes agent webhook ----
# Where incoming WhatsApp messages are POSTed. Leave empty to only log messages in the dashboard.
HERMES_WEBHOOK_URL=http://127.0.0.1:5000/api/webhook
# Sent to Hermes as the "x-hermes-token" header so it can reject other callers.
HERMES_SECRET_TOKEN=change-me-to-a-long-random-string
# How long to wait for Hermes to answer one webhook call, how many times to retry on network errors / HTTP 5xx,
# and max concurrent inbound webhook dispatches.
HERMES_WEBHOOK_TIMEOUT_MS=15000
HERMES_WEBHOOK_RETRIES=2
WEBHOOK_CONCURRENCY=8

# ---- Filters (optional) ----
# Country code used when a number starts with 0 (e.g. 0123456789 -> 60123456789). Leave empty to disable.
DEFAULT_COUNTRY_CODE=60
# Comma-separated phone numbers and/or WhatsApp @usernames (e.g. 60123456789, 0123456789, @alex_tan).
# When set, only messages from these senders reach Hermes.
ALLOWED_NUMBERS=
# Set to false to keep group chats away from Hermes.
FORWARD_GROUPS=true

# ---- Master / Owner Configuration (consumed by Hermes receiver / receiver.env; mirrored here for reference) ----
# Master operator phone number (with country code, digits only, e.g. 60123456789).
# Used for escalations, 1:1 DM command authority, and alerts. Also supported as OWNER_WHATSAPP in receiver.env.
MASTER_PHONE=
# Optional 15-digit WhatsApp LID for Master 1:1 DM recognition when WhatsApp hides phone digits behind @lid.
MASTER_LID=
# Master operator name used when speaking on their behalf (e.g. Alex, Desmond).
MASTER_NAME=
# Voice-note transcription works out of the box locally using pure-Node ONNX Whisper (WHISPER_MODEL=base in receiver.env).
